NODE_ENV=development
PORT=3001
BACKEND_URL=http://localhost:3001

# Database (Supabase): pooled (6543, pgbouncer) + direct (5432, migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Admin
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_TOKEN=

# Email
BREVO_API_KEY=

# Payments
PAYPAL_USER=
REVOLUT_USER=

# Gmail parser (JSON OAuth client)
GMAIL_CREDENTIALS=
