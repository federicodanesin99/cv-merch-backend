# Copy to .env for local development. Never commit .env.
# ⚠️ Point DATABASE_URL at the LOCAL database: Prisma CLI refuses remote hosts unless PRISMA_ALLOW_REMOTE=1.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Local Postgres (runtime + Prisma CLI). In production DATABASE_URL is the Supabase pooler (6543, ?pgbouncer=true)
# and DIRECT_URL the direct connection (5432) used by migrations.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/cv_merch_dev"
# DIRECT_URL=

# Comma-separated allow-list (required in production)
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
